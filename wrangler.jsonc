// Cloudflare Workers 設定（本番スクリプト。このブランチのデプロイ先）。
// - name は本番 Worker `noutore-biyori`。試験 Worker `noutore-biyori-staging` とは別。
// - routes / custom_domain は置かない。noutorebiyori.com の割り当ては、NOBU が変数を入れてから別作業。
// - 平文の vars はデプロイのたびにこの一覧で置き換わる。ダッシュボードだけにある平文は消える。
//   秘密（SMTP_USER / SMTP_PASS / SANITY_REVALIDATE_SECRET / INDEXNOW_KEY / SANITY_WRITE_TOKEN 等）は書かない。
//   wrangler deploy は secret を keep する。このファイルに env ブロックは無い（試験 Worker は別ブランチの設定）。
// - run_worker_first は全パスを Worker に通す。*.workers.dev だけ noindex（静的ファイル含む）。
//   本番ホストの静的ファイルには noindex を付けない（試験用の _headers は使わない）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noutore-biyori",
  "main": "src/cloudflare-entry.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
    "run_worker_first": ["/*"]
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // 関連記事の続きを、公開インターネットを経由せず次のリクエストとして自分に渡す。
  // 各リクエストが自分の CPU 予算を使う。秘密や vars はここへ書かない。
  "services": [{ "binding": "SELF", "service": "noutore-biyori" }],
  // 秘密でない値だけ。次の deploy でダッシュボードの同名平文が消えないようにここへ置く。
  "vars": {
    "PUBLIC_SITE_URL": "https://noutorebiyori.com",
    "CF_ARTICLE_CACHE_TTL": "86400",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "MAIL_TO": "nbwmedia.jp@gmail.com",
    "SANITY_PROJECT_ID": "quljge22",
    "SANITY_DATASET": "production",
    "SANITY_API_VERSION": "2024-01-01"
  }
}
